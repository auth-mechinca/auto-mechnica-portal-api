# API
PORT=4000
NODE_ENV=development

# Persistent Express process runs alongside Postgres on the same host,
# so a normal long-lived pool is correct here — no PgBouncer, no pool size of 1.
# All objects live in the `app` schema, never `public`. Drizzle emits fully
# qualified names so search_path is not strictly required, but setting it keeps
# hand-written psql sessions honest.
#
# These defaults match docker-compose.yml, so `npm run db:setup` then `npm run dev`
# works with no edits. Change both passwords for anything that is not localhost.
DATABASE_URL=postgres://auto_mechanica_app:app_dev_only@localhost:5432/auto_mechanica?options=-c%20search_path%3Dapp
DB_POOL_MAX=10

# Migrations run as a separate, DDL-privileged user; the app user above has no DDL rights.
MIGRATION_DATABASE_URL=postgres://auto_mechanica_migrator:migrator_dev_only@localhost:5432/auto_mechanica

# Overrides for docker-compose.yml. Set POSTGRES_PORT if 5432 is already taken.
# POSTGRES_PORT=5433

# Auth — role claim is embedded in the JWT and re-checked server-side on every request.
JWT_SECRET=CHANGE_ME_min_32_chars_use_openssl_rand_base64_32
JWT_EXPIRES_IN=8h

# Frontend origin (Next.js on Vercel) allowed to call this API
CORS_ORIGIN=http://localhost:3000
